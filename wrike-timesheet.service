[Unit]
Description=Wrike Timesheet & Remote Work Tracker Service
Documentation=https://github.com/wrike/timesheet-app
After=network.target

[Service]
Type=simple
User=wrikeapp
Group=wrikeapp
WorkingDirectory=/opt/wrike-timesheet-app
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5s
Environment=NODE_ENV=production
Environment=PORT=3000

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

# Logging to standard systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wrike-timesheet

[Install]
WantedBy=multi-user.target
